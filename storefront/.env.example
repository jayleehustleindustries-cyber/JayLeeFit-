# Stripe Checkout Integration
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_secret_here

# Data API - Google Sheets Integration
EHC_SHEET_ID=1-UcTy4Cr_NPK622SPRXob7LfpHFEw5874mv9y5E90Ys
GOOGLE_SHEETS_API_KEY=your_google_api_key_here

# Data API - Google Drive Image Sync
GOOGLE_DRIVE_FOLDER_ID=your_ehc_import_folder_id_here
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_here

# Stale Inventory Ladder — the 30/60/90 automation
# CRON_SECRET is what separates "preview" from "actually edits listings":
# Vercel Cron sends it automatically once set here. Without it the endpoint is
# read-only, so set it before you expect prices to move.
CRON_SECRET=generate_a_long_random_string

# Ladder guardrails (optional — defaults shown)
STALE_ABSOLUTE_FLOOR=8          # no listing ever drops below this many dollars
STALE_FLOOR_PCT=0.5             # ...nor below this fraction of realistic sold value
STALE_MAX_EDITS_PER_RUN=40      # blast radius cap for a single run

# Direct eBay writes for everyday_hustle_clothing_co (optional).
# Unset, the ladder still reaches eBay through the CSV feed Vendoo pulls —
# this only upgrades that from "next Vendoo sync" to "immediately".
EBAY_OAUTH_TOKEN=
EBAY_SITE_ID=0

# Data API - Blob Storage (Optional, for future image hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Environment
NODE_ENV=development
