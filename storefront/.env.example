# Inventory hub — EHC Inventory Log V2 (public read via CSV export; the id
# is not a secret). Sheet must be shared "Anyone with the link – Viewer".
GOOGLE_SHEET_ID=17JeIyMsos60gqsppplILJYnQVV1276V5KxODcDo-PuI
# Leave blank to read the first tab; set only if the inventory tab isn't first.
