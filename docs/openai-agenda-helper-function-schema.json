{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jayleehustleindustries.com/schemas/openai-agenda-helper-tools.json",
  "title": "Safe Agenda and Helper Onboarding Tools",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "function"],
        "properties": {
          "type": { "const": "function" },
          "function": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "strict", "parameters"],
            "properties": {
              "name": { "const": "calendar_list_calendars" },
              "description": { "const": "Read-only: list calendars available in the approved company Google Workspace account. Never creates or changes events." },
              "strict": { "const": true },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["account_label", "correlation_id"],
                "properties": {
                  "account_label": { "type": "string", "minLength": 3, "maxLength": 200 },
                  "correlation_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,100}$" }
                }
              }
            }
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "function"],
        "properties": {
          "type": { "const": "function" },
          "function": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "strict", "parameters"],
            "properties": {
              "name": { "const": "calendar_list_events" },
              "description": { "const": "Read-only: list bounded calendar events in a date range to identify conflicts and available work blocks. Never creates or changes events." },
              "strict": { "const": true },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["calendar_id", "start_date", "end_date", "max_events", "correlation_id"],
                "properties": {
                  "calendar_id": { "type": "string", "minLength": 1, "maxLength": 300 },
                  "start_date": { "type": "string", "format": "date" },
                  "end_date": { "type": "string", "format": "date" },
                  "max_events": { "type": "integer", "minimum": 1, "maximum": 500 },
                  "correlation_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,100}$" }
                }
              }
            }
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "function"],
        "properties": {
          "type": { "const": "function" },
          "function": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "strict", "parameters"],
            "properties": {
              "name": { "const": "preview_monthly_agenda" },
              "description": { "const": "Prepare but do not create company calendar events. Produces a deterministic agenda preview and preview hash for human approval." },
              "strict": { "const": true },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["calendar_id", "month", "timezone", "events", "source_context", "reason", "idempotency_key", "correlation_id"],
                "properties": {
                  "calendar_id": { "type": "string", "minLength": 1, "maxLength": 300 },
                  "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
                  "timezone": { "type": "string", "minLength": 3, "maxLength": 80 },
                  "events": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["title", "start", "end", "owner", "business_unit", "description", "source_refs"], "properties": { "title": { "type": "string", "minLength": 3, "maxLength": 200 }, "start": { "type": "string", "format": "date-time" }, "end": { "type": "string", "format": "date-time" }, "owner": { "type": "string", "minLength": 1, "maxLength": 200 }, "business_unit": { "type": "string", "enum": ["Magicdeals Wholesale Outlet", "EHC", "JayLeeFit", "Shared Company"] }, "description": { "type": "string", "maxLength": 3000 }, "source_refs": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 20 }, "attendees": { "type": "array", "items": { "type": "string", "maxLength": 300 }, "maxItems": 50 }, "reminder_minutes": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 10080 }, "maxItems": 5 } } } },
                  "source_context": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "minItems": 1, "maxItems": 50 },
                  "reason": { "type": "string", "minLength": 10, "maxLength": 1000 },
                  "idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,150}$" },
                  "correlation_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,100}$" }
                }
              }
            }
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "function"],
        "properties": {
          "type": { "const": "function" },
          "function": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "strict", "parameters"],
            "properties": {
              "name": { "const": "preview_helper_task_sheet" },
              "description": { "const": "Prepare but do not deliver Marie’s starter task sheet. Includes prioritized tasks, expected output, source links, due dates, and AI teaching instructions." },
              "strict": { "const": true },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["helper_name", "month", "tasks", "source_context", "reason", "idempotency_key", "correlation_id"],
                "properties": {
                  "helper_name": { "const": "Marie" },
                  "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
                  "tasks": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["task_id", "title", "priority", "business_unit", "due_date", "estimated_minutes", "instructions", "definition_of_done", "source_refs", "ai_coaching_prompt"], "properties": { "task_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{3,100}$" }, "title": { "type": "string", "minLength": 3, "maxLength": 200 }, "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] }, "business_unit": { "type": "string", "enum": ["Magicdeals Wholesale Outlet", "EHC", "JayLeeFit", "Shared Company"] }, "due_date": { "type": "string", "format": "date" }, "estimated_minutes": { "type": "integer", "minimum": 5, "maximum": 480 }, "instructions": { "type": "string", "minLength": 20, "maxLength": 4000 }, "definition_of_done": { "type": "string", "minLength": 10, "maxLength": 1500 }, "source_refs": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 20 }, "ai_coaching_prompt": { "type": "string", "minLength": 20, "maxLength": 3000 }, "sensitive_data_required": { "type": "boolean" } } } },
                  "source_context": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "minItems": 1, "maxItems": 50 },
                  "reason": { "type": "string", "minLength": 10, "maxLength": 1000 },
                  "idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,150}$" },
                  "correlation_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,100}$" }
                }
              }
            }
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "function"],
        "properties": {
          "type": { "const": "function" },
          "function": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "strict", "parameters"],
            "properties": {
              "name": { "const": "deliver_approved_agenda_and_task_sheet" },
              "description": { "const": "Deliver exactly one previously previewed and human-approved monthly agenda and Marie task sheet to the approved calendar and company task destination. The host must validate approval, preview hash, account, and idempotency." },
              "strict": { "const": true },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["calendar_preview_hash", "task_sheet_preview_hash", "approval_token", "calendar_id", "task_destination", "idempotency_key", "correlation_id"],
                "properties": {
                  "calendar_preview_hash": { "type": "string", "pattern": "^[A-Fa-f0-9]{32,128}$" },
                  "task_sheet_preview_hash": { "type": "string", "pattern": "^[A-Fa-f0-9]{32,128}$" },
                  "approval_token": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{16,200}$" },
                  "calendar_id": { "type": "string", "minLength": 1, "maxLength": 300 },
                  "task_destination": { "type": "string", "enum": ["google_sheets", "hubspot_tasks", "approved_company_drive"] },
                  "idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,150}$" },
                  "correlation_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,100}$" }
                }
              }
            }
          }
        }
      }
    ]
  }
}
