# Required for application intake and payment self-reports.
DATABASE_URL=mysql://user:password@host:3306/jayleefit

# Required for the live AI blueprint generator in a Manus-compatible runtime.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional package prices revealed after a completed qualification.
FOUNDATION_PRICE=Contact for Pricing
RECOMP_PRICE=Contact for Pricing
LEGACY_PRICE=Contact for Pricing

# Optional analytics. Both values must be set before the browser loads Umami.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional Manus OAuth/runtime integration.
VITE_APP_ID=
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
